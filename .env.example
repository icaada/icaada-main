# ICAADA environment variables. Copy to `.env` (never commit `.env`).
# Every variable below is required; the app validates them at startup
# (src/lib/env.ts) and refuses to boot with a clear message if one is wrong.

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Runtime connection used by the app (may be a pooled URL, e.g. PgBouncer/Neon pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icaada?schema=public"
# Direct (non-pooled) connection used by Prisma CLI for migrate/seed.
# For a local database this is usually the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/icaada?schema=public"
# Optional: max DB connections per server instance (default 10). Use a small
# number (e.g. 1–3) on serverless hosts, and 1 with `prisma dev` (single-connection).
# DATABASE_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs the `icaada_session` JWT cookie. At least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=""

# ── Cloudinary (media) ───────────────────────────────────────────────────────
# Cloud name; must match the images allow-list in next.config.ts (dcvyjmflf today).
CLOUDINARY_CLOUD_NAME="dcvyjmflf"
# Numeric API key from the Cloudinary dashboard.
CLOUDINARY_API_KEY=""
# API secret. Server-only: used to sign direct browser uploads, never sent to clients.
CLOUDINARY_API_SECRET=""

# ── Site URL ─────────────────────────────────────────────────────────────────
# Base URL used in emailed links (password reset, invites, unsubscribe).
# Optional on Vercel (falls back to the production domain); set it elsewhere.
# APP_URL="https://www.icaada.com.ng"

# ── Email (SMTP via Nodemailer) ──────────────────────────────────────────────
# Any SMTP provider works. Optional: without SMTP_HOST, emails are printed to
# the server log in development and skipped in production.
# Examples: Postmark smtp.postmarkapp.com (user and pass = server API token),
#           Brevo smtp-relay.brevo.com, Google Workspace smtp.gmail.com (app password).
# SMTP_HOST="smtp.postmarkapp.com"
# 587 = STARTTLS (default), 465 = implicit TLS.
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# Sender address; your provider must allow it (verified domain or sender).
# EMAIL_FROM="ICAADA <no-reply@icaada.com.ng>"

# ── Seed accounts (optional; used only by `pnpm db:seed`) ────────────────────
# Defaults are obviously fake dev accounts (admin@example.org / editor@example.org)
# and are refused when NODE_ENV=production.
# SEED_ADMIN_NAME="Dev Admin"
# SEED_ADMIN_EMAIL="admin@example.org"
# SEED_ADMIN_PASSWORD="dev-admin-password-123"
# SEED_EDITOR_NAME="Dev Editor"
# SEED_EDITOR_EMAIL="editor@example.org"
# SEED_EDITOR_PASSWORD="dev-editor-password-123"
